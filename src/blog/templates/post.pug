extends layout

block content
	div.blog-progress
		span#blog-progress-bar

	div.blog.blog-single
		header.blog-header
			a.blog-back(href=`${root}blog/${suffix}`) &larr; Blog

		article.blog-article
			h1.blog-post-title= post.title
			div.blog-post-info
				time.blog-post-date= post.date
				span.blog-post-words #{post.readingTime} 分钟阅读
				if post.tags.length
					ul.blog-item-tags
						each item in post.tagObjs
							li
								a(href=`${root}blog/tags/${item.slug}/${suffix}`)= item.name

			if post.toc.length
				nav.blog-toc
					h2.blog-toc-title 目录
					ul
						each item in post.toc
							li(class=`blog-toc-level-${item.level}`)
								a(href=`#${item.id}`)= item.text

			div.blog-content !{post.content}

		if commentsOn
			section.blog-comments#comments
				h2.blog-comments-title
					| 评论
					if commentCount
						span.blog-comments-count= commentCount

				div.blog-comments-list#blog-comments-list
					if comments.length
						each item in comments
							div.blog-comment-item
								div.blog-comment-head
									span.blog-comment-avatar(aria-hidden="true" class=(item.initial ? '' : 'is-default'))
										if item.initial
											= item.initial
									span.blog-comment-nick
										if item.url
											a(href=item.url target="_blank" rel="noopener nofollow")= item.nick
										else
											= item.nick
									if item.email
										span.blog-comment-email= item.email
									time.blog-comment-time(datetime=item.created)= item.created.slice(0, 10)
								div.blog-comment-body= item.content
					else
						p.blog-comments-empty 还没有评论，来说点什么吧。

				form.blog-comment-form#blog-comment-form(method="post" action=(submitUrl || ''))
					div.blog-comment-fields
						label.blog-comment-field
							span 昵称
							input#comment-nick(type="text" name="nick" maxlength="40" placeholder="匿名" autocomplete="nickname")
						label.blog-comment-field
							span 邮箱
							input#comment-email(type="email" name="email" maxlength="120" placeholder="选填，将公开显示" autocomplete="email")
						label.blog-comment-field
							span 网站
							input#comment-url(type="url" name="url" maxlength="200" placeholder="选填" autocomplete="url")
					label.blog-comment-field
						span 内容
						textarea#comment-content(name="content" rows="4" maxlength="2000" placeholder="友善发言，支持 Markdown 之外的纯文本" required)
					div.blog-comment-actions
						button.blog-comment-submit#blog-comment-submit(type="submit") 发表评论
						span.blog-comment-status#blog-comment-status(role="status" aria-live="polite")

		footer.blog-footer
			a.blog-back(href=`${root}blog/${suffix}`) &larr; 返回列表

	button#blog-top.blog-top(type="button" aria-label="回到顶部") &uarr;

	if jsInline
		script!= jsInline
	else
		script(src=`${root}js/blog.js`)
