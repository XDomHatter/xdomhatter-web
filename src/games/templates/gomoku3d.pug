extends layout

block content
	div.game3d
		header.game3d-header
			a.game3d-back(href=`${root}games/${suffix}`) &larr; 游戏列表
			h1.game3d-title= gameTitle
			p.game3d-sub= gameSub

		//- ---------- 大厅 ----------
		section#lobby.game3d-lobby
			div.game3d-panel
				h2.game3d-panel-title 创建房间
				p.game3d-panel-desc 设定棋盘边长与连子数，生成房间号后发给对手。

				div.game3d-field
					label(for="opt-n") 棋盘边长 N
					input#opt-n(type="range" min="3" max="8" value="4" step="1")
					output#opt-n-out 4
				p.game3d-hint 棋盘为 N×N×N，共 #[span#opt-cells 64] 格。N 越大越难连成。

				div.game3d-field
					label(for="opt-m") 连子数 M
					input#opt-m(type="range" min="3" max="8" value="4" step="1")
					output#opt-m-out 4
				p#opt-m-hint.game3d-hint 需要连续 M 个同色格子，M 不得超过 N。

				div.game3d-field
					label(for="opt-grid") 显示网格
					label.game3d-switch
						input#opt-grid(type="checkbox" checked)
						span 显示
				p.game3d-hint 关闭网格可提升难度：只显示已落下的棋子。

				div.game3d-field
					label(for="opt-name") 你的昵称
					input#opt-name.game3d-input(type="text" maxlength="16" placeholder="可留空")

				button#btn-create.game3d-btn.is-primary(type="button") 创建房间

			div.game3d-panel
				h2.game3d-panel-title 加入房间
				p.game3d-panel-desc 输入对手给你的 4 位房间号。

				div.game3d-field
					label(for="join-room") 房间号
					input#join-room.game3d-input.is-code(type="text" inputmode="numeric" maxlength="4" placeholder="0000" autocomplete="off")

				button#btn-join.game3d-btn(type="button") 加入房间

			p#lobby-msg.game3d-msg

		//- ---------- 对局 ----------
		section#arena.game3d-arena(hidden)
			div.game3d-hud
				div.game3d-hud-left
					span#hud-room.game3d-room 房间 ----
					span#hud-config.game3d-meta
					span#hud-last.game3d-meta
				div.game3d-turn
					span#hud-dot.game3d-dot
					span#hud-turn.game3d-turn-text 等待对手…
					span#hud-timer.game3d-timer

			div#stage.game3d-stage
				canvas#canvas3d
				div#stage-tip.game3d-stage-tip 拖拽旋转 · 滚轮缩放 · 在下方用上下键调整坐标落子
				div#overlay.game3d-overlay(hidden)
					div.game3d-overlay-card
						h3#overlay-title.game3d-overlay-title
						p#overlay-desc.game3d-overlay-desc
						div.game3d-overlay-actions
							button#btn-again.game3d-btn.is-primary(type="button") 再来一局
							button#btn-exit.game3d-btn(type="button") 退出房间

			//- ---------- 坐标落子控制台 ----------
			div#move-console.game3d-console
				div.game3d-axes
					each axis in axes
						span.game3d-axis(class=`is-${axis.key}` style=`--axis-color:${axis.color}`)
							b= axis.label
							| 正方向 → 屏幕#{axis.screen}

				//- 每个坐标是一组 spinner：上方读当前值，左右两枚按钮分别是「上一位/下一位」。
				//- 真正被提交的值仍然放在 .game3d-coord-input（视觉隐藏），
				//- 这样校验与回填只有一条数据来源，不随 UI 形态改变。
				form#move-form.game3d-coords(novalidate)
					mixin coordSpinner(key, label)
						span.game3d-coord
							span.game3d-coord-head
								b.game3d-coord-key= key
								span.game3d-coord-value(id=`coord-${key}-value` aria-live="polite") 0
							span.game3d-coord-body
								span.game3d-coord-steps
									button.game3d-coord-step.is-up(type="button" data-step="1" data-axis=key aria-label=`${label} 加大` title="上一位")
										span.game3d-coord-arrow &plus;
									button.game3d-coord-step.is-down(type="button" data-step="-1" data-axis=key aria-label=`${label} 减小` title="下一位")
										span.game3d-coord-arrow &minus;
								input.game3d-coord-input(
									id=`coord-${key}`
									type="text"
									inputmode="numeric"
									autocomplete="off"
									maxlength="1"
									value="0"
									placeholder="0"
									aria-label=`${label} 坐标`
								)
					+coordSpinner('x', 'x')
					+coordSpinner('y', 'y')
					+coordSpinner('z', 'z')
					button#btn-move.game3d-btn.is-primary(type="submit") 落子

				p#coord-hint.game3d-move-hint

			div.game3d-actions
				label.game3d-switch.game3d-switch-inline
					input#arena-grid(type="checkbox" checked)
					span 网格
				button#btn-recenter.game3d-btn.is-small(type="button") 重置视角
				button#btn-resign.game3d-btn.is-small.is-danger(type="button") 认输
				button#btn-leave.game3d-btn.is-small(type="button") 离开

			p#arena-msg.game3d-msg

		//- 规则说明
		details.game3d-rules
			summary 规则
			ul
				li 棋盘是 N³ 个格子，每个格子由 (x, y, z) 唯一确定，坐标取值 0…N-1，默认 (0, 0, 0)。
				li 落子方式：用每个坐标旁的 #[b +] / #[b −] 按钮调整数值（#[b +] 加 1、#[b −] 减 1，
					| 到边界后从另一端继续），调好后按「落子」或回车。
					| 画布只用于观察，拖拽旋转、滚轮缩放，点击不会落子。
				li 每局落子后坐标回到默认 (0, 0, 0)，方便按固定起点推算位置。
				li 坐标正方向以棋盘最小角的三支箭头为准：
					each axis in axes
						|  #[b= axis.label] 指向屏幕#{axis.screen}#{axis === axes[axes.length - 1] ? '。' : '，'}
				li 调整坐标时，棋盘上会出现半透明预览球，落子前即可确认位置。
				li 双方轮流在空格落子，先形成连续 M 个同色格子的一方获胜。
				li 「连续」包含 13 个方向：3 条轴向、6 条面对角线、4 条体对角线。
				li 棋盘下满且无人连成 M 子为平局。
				li 单步限时 120 秒、掉线宽限 60 秒，超时判负。

	if jsInline
		script!= jsInline
	else
		script(src=`${root}js/game3d.js`)