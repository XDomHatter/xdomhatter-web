doctype html
html(lang="zh-CN")
	head
		meta(charset="utf-8")
		meta(name="viewport" content="width=device-width,initial-scale=1,maximum-scale=2")
		meta(name="renderer" content="webkit")
		meta(name="theme-color" content="#060606")

		title= title
		meta(name="description" content=description)

		link(rel="icon" href=`${root}assets/favicon.ico` type="image/x-icon")
		link(rel="shortcut icon" href=`${root}assets/favicon.ico` type="image/x-icon")

		if cssInline
			style!= cssInline
		else
			link(rel="stylesheet" href=`${root}css/games.css`)

		if extraCssInline
			style!= extraCssInline
		else if extraCss
			link(rel="stylesheet" href=`${root}${extraCss}`)

	body.games-body
		block content

		if extraHead
			!= extraHead

		if rulesInline
			script!= rulesInline
		else if rulesSrc
			script(src=`${root}${rulesSrc}`)
